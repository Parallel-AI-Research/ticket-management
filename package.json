{
  "name": "parallel-research",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "dev:fixture": "LOCAL_FIXTURE_MODE=true next dev --hostname 127.0.0.1",
    "test:http": "node scripts/http-smoke.mjs",
    "test:live": "node scripts/live-smoke.mjs",
    "data:prune": "node --import tsx scripts/prune.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "type": "module"
}
