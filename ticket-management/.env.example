# Copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase Connect > Transaction pooler. Server-only credential.
DATABASE_URL=
# Optional direct/session connection for schema changes.
MIGRATION_DATABASE_URL=
# Optional PEM root certificate from Supabase if the endpoint needs a custom CA.
# A quoted value with \n separators is supported. Certificates are always verified.
DATABASE_SSL_CA=
APP_ORIGIN=http://localhost:3000
GATE_MODE=selective
# Comma-separated Supabase user UUIDs allowed to read operator summaries.
OPERATOR_USER_IDS=
# Set a random 32+ character token for server-to-server operator tools.
OPERATOR_TOKEN=
# No sign-up UI; create research accounts through Supabase Auth before trials.
# LOCAL_FIXTURE_MODE is for npm run dev:fixture only; it is rejected in production.
